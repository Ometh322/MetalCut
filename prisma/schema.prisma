// MetalCut — платформа продажи металлорежущего инструмента
// Модель: Category (дерево + схема атрибутов) → Product (карточка, JSONB) → Offer (цена/остаток селлера)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Пользователи и селлеры
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  SELLER
  CUSTOMER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  phone        String?
  role         Role     @default(CUSTOMER)
  seller       Seller?
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum SellerStatus {
  PENDING // ждёт модерации
  ACTIVE
  BLOCKED
}

model Seller {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String // юридическое/торговое название
  brand       String? // отображаемый бренд
  inn         String? // заготовка под B2B
  description String?
  logoUrl     String?
  websiteUrl  String?
  status      SellerStatus @default(PENDING)
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  offers      Offer[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// ---------------------------------------------------------------------------
// Номенклатура: категории + схемы атрибутов
// ---------------------------------------------------------------------------

model Category {
  id              String     @id @default(cuid())
  slug            String     @unique
  name            String
  parentId        String?
  parent          Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children        Category[] @relation("CategoryTree")
  // Схема атрибутов категории (см. src/data/nomenclature.ts, AttributeDef[]).
  // Единый источник для: формы карточки селлера, фасетных фильтров каталога,
  // цели AI-разбора запроса, маппинга колонок при импорте.
  attributeSchema Json?
  sortOrder       Int        @default(0)
  isActive        Boolean    @default(true)
  seoTitle        String?
  seoDescription  String?
  products        Product[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([parentId])
}

// ---------------------------------------------------------------------------
// Товары и офферы
// ---------------------------------------------------------------------------

enum ProductStatus {
  DRAFT // черновик селлера
  PENDING // на модерации
  APPROVED // опубликован
  REJECTED // отклонён (причина в moderationNote)
}

model Product {
  id             String        @id @default(cuid())
  slug           String        @unique
  sku            String // внутренний артикул платформы
  name           String
  brand          String?
  description    String?
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  attributes     Json // валидируется по category.attributeSchema
  images         String[]
  unit           String        @default("шт") // шт | комплект | набор
  status         ProductStatus @default(DRAFT)
  moderationNote String?
  // Денормализация для списка/сортировки — пересчитывается при изменении офферов
  minPrice       Decimal?      @db.Decimal(12, 2)
  maxPrice       Decimal?      @db.Decimal(12, 2)
  offerCount     Int           @default(0)
  offers         Offer[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([categoryId, status])
  @@index([status])
  @@index([brand])
}

model Offer {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerId    String
  seller      Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerSku   String? // артикул продавца
  price       Decimal  @db.Decimal(12, 2)
  oldPrice    Decimal? @db.Decimal(12, 2)
  stock       Int      @default(0)
  leadTimeDays Int     @default(0) // срок поставки, 0 = со склада
  minOrderQty Int      @default(1)
  isActive    Boolean  @default(true)
  orderItems  OrderItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, sellerId])
  @@index([sellerId])
}

// ---------------------------------------------------------------------------
// Заказы (демо: заявка без оплаты)
// ---------------------------------------------------------------------------

enum OrderStatus {
  NEW // новая заявка
  CONFIRMED // подтверждён (селлер/менеджер)
  SHIPPED // отгружен
  COMPLETED // выполнен
  CANCELLED // отменён
}

model Order {
  id              String      @id @default(cuid())
  number          String      @unique // MC-2026-000001
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  status          OrderStatus @default(NEW)
  // Контакты заявки (могут отличаться от аккаунта — B2B-кейс «инженер ищет, снабженец оформляет»)
  contactName     String
  contactPhone    String
  contactEmail    String?
  company         String?
  comment         String?
  total           Decimal     @db.Decimal(14, 2)
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  offerId     String
  offer       Offer   @relation(fields: [offerId], references: [id], onDelete: Restrict)
  sellerId    String // снапшоты на момент заказа — история не зависит от изменений карточек/офферов
  productId   String
  productName String
  productSku  String
  offerSku    String?
  qty         Int
  price       Decimal @db.Decimal(12, 2)
}
